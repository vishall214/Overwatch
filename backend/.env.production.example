# ── OVERWATCH Backend — Production Environment Variables ──────────
# Copy this file and fill in values in your hosting dashboard (Render, etc.)
# Do NOT commit actual secrets to version control.

# ── Database ──────────────────────────────────────────────────────
# Render Postgres: copy the "Internal Database URL" from Render dashboard
# SQLite fallback: leave unset (ephemeral on cloud — data resets on redeploy)
# DATABASE_URL=postgresql://user:password@host:5432/overwatch

# ── Application ──────────────────────────────────────────────────
OVERWATCH_DEBUG=false
# OVERWATCH_SECRET_KEY=<auto-generated-on-render>

# ── CORS ─────────────────────────────────────────────────────────
# Set to your Vercel frontend domain
OVERWATCH_CORS_ORIGINS=["https://your-app.vercel.app"]

# ── Detection ────────────────────────────────────────────────────
OVERWATCH_DETECTION_DEVICE=cpu
OVERWATCH_DETECTION_CONFIDENCE=0.5
OVERWATCH_DETECTION_IMG_SIZE=640

# ── Streaming ────────────────────────────────────────────────────
# OVERWATCH_STREAM_QUALITY=80
# OVERWATCH_STREAM_FPS=15

# ── Object Storage (optional — for persistent snapshots/clips) ───
# OVERWATCH_USE_S3=true
# OVERWATCH_S3_BUCKET=overwatch-storage
# OVERWATCH_S3_REGION=us-east-1
# OVERWATCH_S3_ACCESS_KEY_ID=
# OVERWATCH_S3_SECRET_ACCESS_KEY=
# OVERWATCH_S3_ENDPOINT_URL=  # For MinIO or DigitalOcean Spaces

# ── Email Reports (optional) ─────────────────────────────────────
# OVERWATCH_REPORT_EMAIL_ENABLED=true
# OVERWATCH_SMTP_HOST=smtp.gmail.com
# OVERWATCH_SMTP_PORT=587
# OVERWATCH_SMTP_USERNAME=
# OVERWATCH_SMTP_PASSWORD=
# OVERWATCH_SMTP_FROM=
