# ── OVERWATCH Environment Configuration ──────────────────────
# Copy this file to .env and customise values as needed.
# All variables are prefixed with OVERWATCH_ to avoid collisions.

# ── Application ──────────────────────────────────────────────
# OVERWATCH_APP_NAME=OVERWATCH
# OVERWATCH_APP_VERSION=0.1.0
# OVERWATCH_DEBUG=true

# ── Server ───────────────────────────────────────────────────
# OVERWATCH_HOST=0.0.0.0
# OVERWATCH_PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# OVERWATCH_CORS_ORIGINS=["http://localhost:3000"]

# ── Video Capture ────────────────────────────────────────────
# OVERWATCH_VIDEO_SOURCE=0                 # 0 for webcam, path or RTSP URL
# OVERWATCH_FRAME_WIDTH=640
# OVERWATCH_FRAME_HEIGHT=480
# OVERWATCH_CAPTURE_FPS=30

# ── Detection (YOLOv8) ──────────────────────────────────────
# OVERWATCH_DETECTION_MODEL=yolov8n.pt
# OVERWATCH_DETECTION_CONFIDENCE=0.5
# OVERWATCH_DETECTION_IOU_THRESHOLD=0.45
# OVERWATCH_DETECTION_MAX_DET=100
# OVERWATCH_DETECTION_IMG_SIZE=640
# OVERWATCH_DETECTION_DEVICE=cpu
# OVERWATCH_DETECTION_CLASSES=[0]          # COCO IDs: 0=person

# ── Streaming ───────────────────────────────────────────────
# OVERWATCH_STREAM_QUALITY=80             # JPEG quality 1-100
# OVERWATCH_STREAM_FPS=15

# ── Storage ─────────────────────────────────────────────────
# OVERWATCH_WEIGHTS_DIR=weights
# OVERWATCH_STORAGE_DIR=storage
# OVERWATCH_SNAPSHOTS_DIR=storage/snapshots
# OVERWATCH_CLIPS_DIR=storage/clips

# ── Pipeline ────────────────────────────────────────────────
# OVERWATCH_PIPELINE_SKIP_FRAMES=0        # 0 = process every frame
# OVERWATCH_PIPELINE_MAX_RESOLUTION=640
# OVERWATCH_QUEUE_SIZE=32
